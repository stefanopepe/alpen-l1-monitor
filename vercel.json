{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/collect.ts": {
      "maxDuration": 800,
      "includeFiles": "config/**"
    },
    "api/refresh.ts": {
      "maxDuration": 800,
      "includeFiles": "config/**"
    },
    "api/status.ts": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/consolidation.ts": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/metrics.ts": {
      "maxDuration": 30
    },
    "api/time-machine.ts": {
      "maxDuration": 30
    },
    "api/research-refresh.ts": {
      "maxDuration": 800,
      "includeFiles": "config/**"
    }
  },
  "crons": [
    {
      "path": "/api/collect",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/research-refresh",
      "schedule": "55 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "outputDirectory": "dist"
}
