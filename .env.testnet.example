# Separate Signet deployment. Never copy mainnet database URLs into this file.
# Copy to .env.testnet (ignored); use the explicit --env-file launcher in docs/deployment.md.
NETWORK=signet
DATABASE_URL=
DATABASE_URL_METRICS=
MIGRATION_DATABASE_URL=
CRON_SECRET=
# Only needed if the selected testnet Esplora requires this secret.
ALPEN_ESPLORA_TOKEN=
# Leave unset for real wallet data. Set demo only for synthetic UI previews.
STAGING_PREVIEW=
