# Copy to .env for local development; keep values out of git and chat.
NETWORK=mainnet
DATABASE_URL=postgres://monitor_app@localhost:6432/monitor
DATABASE_URL_METRICS=postgres://monitor_read@localhost:6432/monitor
MIGRATION_DATABASE_URL=postgres://monitor_owner@localhost:5432/monitor
# Generate using: openssl rand -hex 32. Required for collection only; reads are public.
CRON_SECRET=
# Private Esplora credential: raw token only, without the ?token= prefix.
# Set this locally and as a Sensitive Production variable in Vercel before switching providers.
ALPEN_ESPLORA_TOKEN=
# Optional RPC adapter only. Never used for address discovery or inventory.
ALCHEMY_RPC_URL=
